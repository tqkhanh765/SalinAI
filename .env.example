# =============================================================================
# SalinAI — Root Environment Variables Template
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in every value below.
# 3. NEVER commit .env to Git.
# 4. Place serviceAccountKey.json in ./backend/ (also git-ignored).
# =============================================================================


# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=3001
# URL the backend CORS policy allows. Set to your Vercel URL in production.
FRONTEND_URL=http://localhost:80


# ─── Firebase Admin SDK (Backend) ─────────────────────────────────────────────
# Found in: Firebase Console → Project Settings → Service Accounts
# You ALSO need to download serviceAccountKey.json and place it in ./backend/
FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.asia-southeast1.firebasedatabase.app


# ─── Firebase Client SDK (Frontend) ───────────────────────────────────────────
# Found in: Firebase Console → Project Settings → Your Apps → Web App Config
# These are PUBLIC values — safe to expose in browser bundles.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx


# ─── Frontend → Backend URL ────────────────────────────────────────────────────
# Used by the React app to call the backend REST API.
# Local:       http://localhost:3001
# Production:  https://your-backend.onrender.com
VITE_BACKEND_URL=http://localhost:3001


# ─── Gemini / Google AI (P0 — Required) ───────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key


# ─── Telegram Alerts (P1 — Optional for MVP) ──────────────────────────────────
# Create a bot via @BotFather on Telegram. Get the chat ID by messaging the bot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id


# ─── MongoDB Atlas (P1 — RAG Phase, Deferrable) ───────────────────────────────
# Create a free cluster at: https://cloud.mongodb.com
# Connection string → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/salinai?retryWrites=true&w=majority


# ─── OpenWeatherMap (P1 — Deferrable) ─────────────────────────────────────────
# Free tier available at: https://openweathermap.org/api
# Used by the check_weather tool. Leave blank to use the mocked response.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
# City name or lat/lon for the Mekong Delta monitoring location
OPENWEATHERMAP_LOCATION=Can Tho,VN
